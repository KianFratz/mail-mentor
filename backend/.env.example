# Local development defaults. Never reuse these secrets in production.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://mailmentor:mailmentor-local-only@localhost:5432/mailmentor?schema=public
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:8080
JWT_SECRET=local-access-secret-change-before-deployment
JWT_REFRESH_SECRET=local-refresh-secret-change-before-deployment
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d

# Required for AI replies and feedback, and required at production startup.
OLLAMA_API_KEY=

# Optional in development. Configure both values to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required in production for fixed-period Pro checkout.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Required in production for account email flows.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Optional release identifier included in health responses and logs.
APP_VERSION=
