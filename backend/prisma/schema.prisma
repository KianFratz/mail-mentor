// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique @db.VarChar(255)
  password           String?
  name               String?
  googleId           String?    @unique
  googleRefreshToken String?
  role               UserRole   @default(student)
  currentLevel       SkillLevel @default(beginner)
  xpTotal            Int        @default(0)
  practice_streak    Int        @default(0)
  lastActiveAt       DateTime?  @db.Timestamptz
  createdAt          DateTime   @default(now()) @db.Timestamptz
  updatedAt          DateTime   @default(now()) @updatedAt @db.Timestamptz

  writingSession WritingSession[]
  authProviders  AuthProvider[]

  @@map("users")
}

enum UserRole {
  student
  professional
  admin
}

enum SkillLevel {
  beginner
  intermediate
  advanced
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model WritingSession {
  id          String        @id @default(uuid()) @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String        @db.Uuid
  status      SessionStatus @default(draft)
  subjectLine String
  textBody    String
  wordCount   Int
  scenario    Scenario      @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scenarioId  String        @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz()
  updatedAt   DateTime      @default(now()) @db.Timestamptz()
  messages    Message[]

  @@map("writing_sessions")
}

model Scenario {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  category    String
  level       SkillLevel @default(beginner)
  aiPersona   Json
  description String
  color       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  writingSession WritingSession[]

  @@map("scenarios")
}

enum SessionStatus {
  draft
  submitted
  graded
  abandoned
}

enum MessageRole {
  USER
  ASSISTANT
}

model Message {
  id               String         @id @default(cuid())
  role             MessageRole
  content          String
  writingSession   WritingSession @relation(fields: [writingSessionId], references: [id], onDelete: Cascade)
  writingSessionId String         @db.Uuid
  createdAt        DateTime       @default(now())

  @@index([writingSessionId, createdAt])
  @@map("messages")
}
