generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String           @id @default(uuid()) @db.Uuid
  email              String           @unique @db.VarChar(255)
  password           String?
  name               String?
  googleId           String?          @unique
  googleRefreshToken String?
  role               UserRole         @default(student)
  currentLevel       SkillLevel       @default(beginner)
  xpTotal            Int              @default(0)
  lastActiveAt       DateTime?        @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  authProviders      AuthProvider[]
  writingSession     WritingSession[]
  userStreak         UserStreak[]
  practiceLog        PracticeLog[]

  @@map("users")
}

model WritingSession {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  status          SessionStatus    @default(draft)
  subjectLine     String
  textBody        String
  wordCount       Int
  scenarioId      String           @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @db.Timestamptz(6)
  messages        Message[]
  scenario        Scenario         @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionFeedback SessionFeedback?

  @@map("writing_sessions")
}

model Scenario {
  id             String           @id @default(uuid()) @db.Uuid
  title          String
  category       String
  level          SkillLevel       @default(beginner)
  description    String
  color          String
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt
  aiPersona      Json
  writingSession WritingSession[]

  @@map("scenarios")
}

model Message {
  id               String         @id @default(cuid())
  role             MessageRole
  content          String
  writingSessionId String         @db.Uuid
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  writingSession   WritingSession @relation(fields: [writingSessionId], references: [id], onDelete: Cascade)

  @@index([writingSessionId, createdAt])
  @@map("messages")
}

model SessionFeedback {
  id                String         @id @default(uuid()) @db.Uuid
  writingSessionId  String         @unique @db.Uuid
  overallScore      Int
  categoryScores    Json
  strengths         Json
  improvements      Json
  suggestedRevision Json
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  writingSession    WritingSession @relation(fields: [writingSessionId], references: [id], onDelete: Cascade)

  @@map("session_feedbacks")
}

model PracticeLog {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date // day-only, in user's local timezone
  createdAt DateTime @default(now())

  @@unique([userId, date]) // one row per user per day
  @@index([userId, date])
  @@map("practice_logs")
}

model UserStreak {
  userId              String    @id @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak       Int       @default(0)
  longestStreak       Int       @default(0)
  lastActiveDate      DateTime? @db.Date
  updateAt            DateTime  @updatedAt
  graceUsedThisStreak Boolean   @default(false)
  monthlyPercentile   Float?
  percentileUpdatedAt  DateTime?

  @@map("user_streaks")
}

enum UserRole {
  student
  professional
  admin
}

enum SkillLevel {
  beginner
  intermediate
  advanced
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum SessionStatus {
  draft
  submitted
  graded
  abandoned
}

enum MessageRole {
  USER
  ASSISTANT
}
